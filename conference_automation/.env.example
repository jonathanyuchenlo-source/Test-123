# ── OpenAI（Whisper 語音轉文字）─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic（Claude memo 生成）────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Microsoft Azure App（OneNote）────────────────────────────────────────────
# 到 https://portal.azure.com → App registrations → 新建 App
# Redirect URI 選 "Public client / native" → http://localhost
# API permissions 加入：Notes.ReadWrite (Delegated)
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=your_client_secret_here
MS_TENANT_ID=common

# ── OneNote 目的地 ────────────────────────────────────────────────────────────
ONENOTE_NOTEBOOK=Investment Memos
ONENOTE_SECTION=Conference Notes

# ── 監控資料夾（iCloud / Dropbox 同步路徑）─────────────────────────────────
# macOS iCloud 範例：
# WATCH_FOLDER=/Users/yourname/Library/Mobile Documents/com~apple~CloudDocs/VoiceMemos
# Dropbox 範例：
# WATCH_FOLDER=/Users/yourname/Dropbox/VoiceMemos
WATCH_FOLDER=/path/to/your/voice/memos/folder

# ── Whisper 語言（zh=中文, en=英文, auto=自動偵測）─────────────────────────
WHISPER_LANGUAGE=zh

# ── 已處理檔案紀錄（避免重複處理）──────────────────────────────────────────
PROCESSED_LOG=./processed_files.txt
