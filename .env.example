# ── News Screener API Keys ──────────────────────────────────────────────────

# NewsAPI (free tier: 100 req/day, covers Reuters / WSJ / Bloomberg headlines)
# Sign up at https://newsapi.org  →  takes ~2 minutes, no credit card
NEWSAPI_KEY=your_newsapi_key_here

# Anthropic / Claude API (for AI relevance scoring)
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
